+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""What the planner learns about LIBERO's success predicate (the "oracle").
+
+Two independent switches (``--oracle-info``, ``--oracle-dynamics``):
+
+``oracle_info``
+    ``visible``  unchanged: tool results, state records and ``states.json`` carry
+                 ``terminated`` / ``truncated``; the prompt, the tool descriptions
+                 and the guides tell the planner to aim for ``terminated == true``.
+    ``hidden``   ``fields`` + ``prompt`` together.
+    ``fields``   the oracle FIELDS are removed from everything the planner can
+                 read (tool results, ``view_env_state``, ``states.json``), the
+                 ``pi0_doubled`` success flag (which is the predicate itself) is
+                 dropped and ``pi0_pick`` reports only its own lift/grip test;
+                 the text is left as it is.
+    ``prompt``   only the TEXT is rewritten (system prompt, tool descriptions,
+                 guides) so that it no longer refers to a success flag; the fields
+                 stay.
+
+``oracle_dynamics``
+    ``coupled``  unchanged: every primitive stops as soon as the predicate holds
+                 and any later env step is refused (``env_client`` asserts).
+    ``free``     the environment keeps running after success; success is only
+                 logged for the experimenter (``LiberoEnvClient.success_*``). With
+                 a visible oracle the reported ``terminated`` is then the predicate
+                 at the latest env step, which can turn false again.
+
+Every rewrite names the exact fragment it replaces and the result is checked for
+any remaining oracle term, so a change of the upstream prompt fails loudly instead
+of leaking silently.
+"""
+
+from __future__ import annotations
+
+import copy
+import json
+import re
+from typing import Any
+
+ORACLE_INFO = ("visible", "hidden", "fields", "prompt")
+ORACLE_DYNAMICS = ("coupled", "free")
+
+#: Any word the planner must not read once the oracle is hidden ("determinate" is fine).
+FORBIDDEN = re.compile(
+    r"(?<![a-z])terminat|task_success|libero_terminated|success_once|"
+    r"success_at_end|signaled term",
+    re.IGNORECASE,
+)
+
+#: Result keys that carry the predicate (``truncated`` goes too, so that the set
+#: of fields never depends on how the episode is going).
+ORACLE_KEYS = frozenset(
+    {
+        "terminated",
+        "truncated",
+        "libero_terminated",
+        "task_success",
+        "success_once",
+        "success_at_end",
+    }
+)
+
+#: What a refused post-success env step reports when the fields are hidden (the
+#: original error text names the termination).
+REJECTED = "action rejected by the environment"
+
+#: Files in the run directory the planner may not read when the fields are hidden.
+DENIED_FILES = frozenset({"states.json"})
+
+
+def hides_fields(info: str) -> bool:
+    return info in ("hidden", "fields")
+
+
+def rewrites_text(info: str) -> bool:
+    return info in ("hidden", "prompt")
+
+
+def has_oracle_terms(obj: Any) -> bool:
+    """True when ``obj`` (any JSON-like value) still names the oracle."""
+    try:
+        text = obj if isinstance(obj, str) else json.dumps(obj, default=str)
+    except (TypeError, ValueError):
+        text = str(obj)
+    return FORBIDDEN.search(text) is not None
+
+
+# ---------------------------------------------------------------------------
+# fields
+# ---------------------------------------------------------------------------
+
+
+def scrub_fields(obj: Any) -> Any:
+    """A copy of a tool result / state record without the oracle fields.
+
+    Bytes (embedded images) are passed through untouched.
+    """
+    if isinstance(obj, dict):
+        out: dict[str, Any] = {}
+        doubled = obj.get("name") == "pi0_doubled"
+        for key, value in obj.items():
+            if key in ORACLE_KEYS:
+                continue
+            if doubled and key in ("success", "diagnostics"):
+                continue
+            if key == "error" and isinstance(value, str) and "signaled term" in value:
+                out[key] = REJECTED
+                continue
+            if key == "traceback" and isinstance(value, str) and FORBIDDEN.search(value):
+                continue
+            out[key] = scrub_fields(value)
+        return out
+    if isinstance(obj, list):
+        return [scrub_fields(v) for v in obj]
+    if isinstance(obj, tuple):
+        return tuple(scrub_fields(v) for v in obj)
+    return obj
+
+
+def report_success(obj: Any, success_now: bool) -> Any:
+    """``oracle_dynamics=free`` with a visible oracle: the primitives never see the
+    predicate (they run on), so their ``terminated`` fields and the
+    ``pi0_doubled`` success flag are set to the predicate at the latest env step."""
+    if isinstance(obj, dict):
+        out = {k: report_success(v, success_now) for k, v in obj.items()}
+        if "terminated" in out:
+            out["terminated"] = bool(success_now)
+        if out.get("name") == "pi0_doubled":
+            for key in ("success", "task_success"):
+                if key in out:
+                    out[key] = bool(success_now)
+        return out
+    if isinstance(obj, list):
+        return [report_success(v, success_now) for v in obj]
+    return obj
+
+
+# ---------------------------------------------------------------------------
+# text
+# ---------------------------------------------------------------------------
+
+_JUDGE = (
+    "The environment does NOT tell you whether the task has succeeded: judge it "
+    "yourself from the images and the robot state."
+)
+
+#: Rendered system prompt of the ``proven`` knowledge profile. Each fragment is one
+#: rendered line (or a unique part of one) and must occur exactly once.
+PROMPT_REWRITES: tuple[tuple[str, str], ...] = (
+    (
+        "> `terminated == true`.",
+        "> completion of the task in `task_language`. " + _JUDGE,
+    ),
+    (
+        "> `terminated:false`). Do NOT call `reset`.",
+        "> failure judgement). Do NOT call `reset`.",
+    ),
+    (
+        "CONTACT skill (success :=",
+        "CONTACT skill (it returns no success",
+    ),
+    (
+        "`terminated`). Use it for drawer/door open-close AND insertions; call it",
+        "flag; check the images). Use it for drawer/door open-close AND insertions; call it",
+    ),
+    (
+        "when a clean placement won't terminate, SUSPECT WRONG-TARGET",
+        "when a clean placement does not achieve the goal, SUSPECT WRONG-TARGET",
+    ),
+    (
+        "`terminated:false` with the max eef-y reached.",
+        "failure audit with the max eef-y reached.",
+    ),
+    (
+        "`terminated`, `truncated`, coord-free `state`, an `artifacts`",
+        "coord-free `state`, an `artifacts`",
+    ),
+    (
+        "YOUR GOAL: produce top-level `terminated == true` in ONE episode.",
+        "YOUR GOAL: complete the task in `task_language` in ONE episode. "
+        + _JUDGE
+        + " Call `finish` with status 'success' only if you believe the goal holds "
+        "now, otherwise with status 'failure'.",
+    ),
+    (
+        "When the task terminates, OR when your single best",
+        "When you judge the task complete, OR when your single best",
+    ),
+    (
+        "(success or honest `terminated:false`), then call `finish`.",
+        "(your honest judgement of success or failure), then call `finish`.",
+    ),
+    (
+        "turn) with success := `terminated` (no lift / no gripper-close",
+        "turn) and returns no success flag (no lift / no gripper-close",
+    ),
+    (
+        "stuck-audit (`terminated:false`) and call `finish`.",
+        "stuck-audit (judged failure) and call `finish`.",
+    ),
+    (
+        "WHEN top-level `terminated == true` in the latest tool result:",
+        "WHEN you judge from the images and the state that the task goal holds:",
+    ),
+    ("terminated:true.", "self_assessed_success:true."),
+    (
+        "terminated:false + strategy_notes describing what you tried in this one",
+        "self_assessed_success:false + strategy_notes describing what you tried in this one",
+    ),
+)
+
+#: Tool descriptions (joined strings of ``robots.libero.tools.TOOLS_SPEC``).
+TOOL_SPEC_REWRITES: dict[str, tuple[tuple[str, str], ...]] = {
+    "pi0_doubled": (
+        (
+            "Returned success/task_success only mirrors official termination; for "
+            "intermediate contact skills, success=false does not necessarily mean "
+            "the contact interaction failed. ",
+            "It returns no success flag. ",
+        ),
+    ),
+    "release": (
+        (" Triggers libero termination if the matching On/In predicate is met.", ""),
+    ),
+}
+
+#: Guides the planner reads with ``read_text_file``.
+GUIDE_REWRITES: dict[str, tuple[tuple[str, str], ...]] = {
+    "pro_hybrid_guide.md": (
+        (
+            "target object, places it on the plate, and `terminated=False` because the",
+            "target object, places it on the plate, and the task is NOT complete because the",
+        ),
+        ('  "terminated": true', '  "self_assessed_success": true'),
+        (
+            "exploration, write `terminated: false` with what you tried and which step",
+            "exploration, write `self_assessed_success: false` with what you tried and which step",
+        ),
+        ("  honest `terminated:false`.", "  honest failure audit."),
+    ),
+    "strict_hybrid_guide.md": (
+        (
+            "top-level `terminated` (the benchmark predicate), which is name-independent.",
+            "your own check of the goal relation in the images (no success flag is reported).",
+        ),
+        ("`terminated:false` audit — never warp.", "failure audit — never warp."),
+        (
+            "(success or an honest `terminated:false`), then call `finish`. Never",
+            "(success or an honest failure judgement), then call `finish`. Never",
+        ),
+        (
+            "| `view_env_state` result | `step`, top-level `task_language`, `terminated`, `truncated`, `state.{",
+            "| `view_env_state` result | `step`, top-level `task_language`, `state.{",
+        ),
+        (
+            "// success mirrors terminated only; inspect image/state for intermediates.",
+            "// returns no success flag; inspect image/state evidence.",
+        ),
+        (
+            "// Open gripper to place. Triggers libero termination if the On/In predicate met.",
+            "// Open gripper to place.",
+        ),
+        (
+            "10. `release` — predicate (`On`/`In`) checks → `terminated=True` if hit.",
+            "10. `release` — check in the next image whether the `On`/`In` relation holds.",
+        ),
+        (
+            "  `terminated` in the returned view.",
+            "  the images in the returned view.",
+        ),
+        (
+            "  `terminated=false` and the object",
+            "  normally and the object",
+        ),
+        (
+            "When top-level `terminated == true`:",
+            "When you judge from the images and the state that the task goal holds:",
+        ),
+        ("  `terminated: true`.", "  `self_assessed_success: true`."),
+        (
+            "`{output_dir}/{recipe_tag}.json` with `terminated: false` +",
+            "`{output_dir}/{recipe_tag}.json` with `self_assessed_success: false` +",
+        ),
+        (
+            "  top-level `terminated` (the benchmark predicate).",
+            "  the images (no success flag is reported).",
+        ),
+    ),
+}
+
+_REDACTED = "(goal check)"
+
+
+def apply_rewrites(
+    text: str,
+    rewrites: tuple[tuple[str, str], ...],
+    where: str,
+    *,
+    strict: bool = True,
+) -> str:
+    """Apply ``rewrites`` in order; ``strict``: each fragment occurs exactly once."""
+    for old, new in rewrites:
+        n = text.count(old)
+        if strict and n != 1:
+            raise RuntimeError(f"{where}: expected exactly one {old!r}, found {n}")
+        text = text.replace(old, new)
+    return text
+
+
+def check_clean(text: str, where: str) -> None:
+    """Raise if ``text`` still names the oracle."""
+    bad = [line for line in text.splitlines() if FORBIDDEN.search(line)]
+    if bad:
+        raise RuntimeError(f"{where}: oracle term left in {len(bad)} line(s): {bad[:3]}")
+
+
+def rewrite_prompt(text: str, variant: str) -> str:
+    """The rendered ``system`` / ``user`` prompt without any reference to a success flag."""
+    if variant == "system":
+        text = apply_rewrites(text, PROMPT_REWRITES, "system prompt")
+    check_clean(text, f"{variant} prompt")
+    return text
+
+
+def rewrite_tool_specs(specs: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """A copy of the tool schemas with descriptions that name no success flag."""
+    out = copy.deepcopy(specs)
+    for spec in out:
+        rewrites = TOOL_SPEC_REWRITES.get(spec.get("name", ""))
+        if rewrites:
+            spec["description"] = apply_rewrites(
+                spec.get("description", ""), rewrites, f"tool {spec['name']}"
+            )
+    check_clean(json.dumps(out), "tool specs")
+    return out
+
+
+def rewrite_guide(name: str, text: str, *, strict: bool = False) -> str:
+    """A guide's text without references to a success flag.
+
+    ``read_text_file`` may return a truncated file, so at run time the fragments are
+    replaced where present and any term a cut fragment leaves behind is redacted;
+    the tests run this with ``strict=True`` on the full guides.
+    """
+    text = apply_rewrites(text, GUIDE_REWRITES.get(name, ()), f"guide {name}", strict=strict)
+    if strict:
+        check_clean(text, f"guide {name}")
+        return text
+    return FORBIDDEN.sub(_REDACTED, text)
+
+
+__all__ = [
+    "DENIED_FILES",
+    "FORBIDDEN",
+    "ORACLE_DYNAMICS",
+    "ORACLE_INFO",
+    "ORACLE_KEYS",
+    "REJECTED",
+    "apply_rewrites",
+    "check_clean",
+    "has_oracle_terms",
+    "hides_fields",
+    "report_success",
+    "rewrite_guide",
+    "rewrite_prompt",
+    "rewrite_tool_specs",
+    "rewrites_text",
+    "scrub_fields",
+]
