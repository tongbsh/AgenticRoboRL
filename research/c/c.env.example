# Plan C configuration. Copy to research/c/c.env, fill in the paths, and every research/c/*.sh script sources it.

# --- code -----------------------------------------------------------------------------------------------
export AGENTICROBORL_DIR=/path/to/AgenticRoboRL          # this repository
export RPENT_DIR=/path/to/RPent-c                        # made by research/c/setup_rpent.sh (both patches applied)

# --- python environments ----------------------------------------------------------------------------------
export RPENT_ENV=/path/to/envs/rpent                     # RPent installed (pip install -e "$RPENT_DIR[full]"), with LIBERO-PRO
export PLANNER_ENV=/path/to/envs/vllm                    # vLLM 0.28 (serves the planner and the VLM judge)
export CTL_PYTHON=$PLANNER_ENV/bin/python                # runs rl/local_ctl.py and the analysis: pyyaml fastapi uvicorn httpx numpy

# --- weights ----------------------------------------------------------------------------------------------
export PI05_CHECKPOINT=/path/to/checkpoints/RLinf-Pi05-LIBERO-130-fullshot-SFT
export SAM3_CHECKPOINT=/path/to/checkpoints/sam3/sam3.pt
export SFT_WEIGHTS=/path/to/AgenticRoboRL-Qwen3.5-9B/sft          # https://huggingface.co/ciciciciliu/AgenticRoboRL-Qwen3.5-9B
export RL_WEIGHTS=/path/to/AgenticRoboRL-Qwen3.5-9B/rl-v006
export BASE_WEIGHTS=/path/to/Qwen3.5-9B                           # only for the optional base-model cells of C1
export JUDGE_MODEL=/path/to/Qwen3-VL-8B-Instruct                  # the external VLM judge (f_vlm)

# --- runs -------------------------------------------------------------------------------------------------
export RUNS_DIR=$AGENTICROBORL_DIR/runs/c
export GPUS="0 1 2 3"                  # one controller per GPU; each runs its own vLLM + Pi0.5 + SAM3
export VLLM_MEM=0.55                   # vLLM's share of a 72 GB card; Pi0.5, SAM3 and 3 LIBERO renderers share the rest
export MAX_MODEL_LEN=262144            # as in the paper; lower it only if vLLM cannot start, and report the change
export MAX_TURNS=100                   # as in the paper
export PORT_BASE_MODEL=18100 PORT_BASE_PROXY=18200 PORT_BASE_VLA=18300 PORT_BASE_SAM3=18400   # + GPU index
export JUDGE_GPU=0 JUDGE_PORT=18500    # the VLM judge runs after a stage's episodes, on one GPU
export INCLUDE_BASE=0                  # 1: C1 also evaluates the base model (optional, section 1.6)
export C2_DYN=0                        # 1: C2 also runs the M-dyn cells (visible/free; secondary, run when time allows)
export C2_SPLIT=0                      # 1: C2 also runs the field-only / prompt-only cells (section 1.4)

# --- offline probes and the stronger judge (research/c/run_offline.sh; one free GPU, after or between stages) -----
export OFFLINE_GPU=0 OFFLINE_PORT=18600
export STRONG_JUDGE_MODEL=/path/to/Qwen3-VL-32B-Instruct-FP8   # f_vlm_strong; any larger VLM vLLM can serve on one card

# LIBERO rendering on headless GPUs
export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl
